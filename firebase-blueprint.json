{
  "entities": {
    "User": {
      "path": "users/{userId}",
      "description": "User profile and sync metadata",
      "fields": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "updatedAt": { "type": "timestamp" }
      }
    },
    "UserHabit": {
      "path": "users/{userId}/habits/{habitId}",
      "description": "User habits and routines with bioscience order and timing",
      "fields": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "targetFrequency": { "type": "string" },
        "scheduledTime": { "type": "string" },
        "orderIndex": { "type": "number" },
        "bioscienceRationale": { "type": "string" },
        "isCustom": { "type": "boolean" },
        "updatedAt": { "type": "timestamp" }
      }
    },
    "UserHabitLog": {
      "path": "users/{userId}/habit_logs/{logId}",
      "description": "Daily habit completion records",
      "fields": {
        "habitId": { "type": "number" },
        "dateString": { "type": "string" },
        "completed": { "type": "boolean" },
        "timestamp": { "type": "number" }
      }
    },
    "ChatMessage": {
      "path": "users/{userId}/chat_messages/{messageId}",
      "description": "Multi-turn Gemini AI consultation history",
      "fields": {
        "role": { "type": "string" },
        "content": { "type": "string" },
        "modelUsed": { "type": "string" },
        "groundingSources": { "type": "array" },
        "timestamp": { "type": "number" }
      }
    }
  }
}
